# Expose Server Configuration
# Copy this file to .env before starting: cp .env.example .env

# The base domain for your tunnel relay (e.g., tunnel.yourdomain.com or localhost)
# Tunnel URLs will be generated as: https://<random-subdomain>.<DOMAIN>
DOMAIN=tunnel.example.com

# Control port where tunnel clients connect (default: 7890)
CONTROL_PORT=7890

# Optional: Authentication token to protect against unauthorized tunnel registration
# If set, clients must connect with: expose tunnel --token=<token>
# EXPOSE_SERVER_TOKEN=your-secret-token
